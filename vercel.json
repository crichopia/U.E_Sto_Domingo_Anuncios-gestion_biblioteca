{
    "functions": {
        "api/index.php": {
        "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
        "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|webp))",
        "dest": "/$1"
        },
        {
        "src": "/(.*)",
        "dest": "/api/index.php"
        }
    ]
}